% ── Theorem Boxes (tcolorbox) ──────────────────────────────
%   Each theorem environment has fully-inlined options
%   to avoid pgfkeys nesting / expansion issues
\newtcbtheorem[auto counter, number within=chapter]{theorem}{定理}{
  enhanced, breakable, arc=3pt, boxrule=0.8pt,
  top=10pt, bottom=6pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  colback=NCWUblue!8!white, colframe=NCWUblue!60!white,
  coltitle=white, fonttitle=\bfseries\sffamily\small,
  attach boxed title to top left={xshift=4mm, yshift=-2.5mm},
  boxed title style={colback=NCWUblue, sharp corners,
    top=1.5pt, bottom=1.5pt, left=3pt, right=3pt}}{thm}

\newtcbtheorem[auto counter, number within=chapter]{definition}{定义}{
  enhanced, breakable, arc=3pt, boxrule=0.8pt,
  top=10pt, bottom=6pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  colback=NCWUteal!8!white, colframe=NCWUteal!60!white,
  coltitle=white, fonttitle=\bfseries\sffamily\small,
  attach boxed title to top left={xshift=4mm, yshift=-2.5mm},
  boxed title style={colback=NCWUteal, sharp corners,
    top=1.5pt, bottom=1.5pt, left=3pt, right=3pt}}{def}

\newtcbtheorem[auto counter, number within=chapter]{lemma}{引理}{
  enhanced, breakable, arc=3pt, boxrule=0.8pt,
  top=10pt, bottom=6pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  colback=NCWUpurple!8!white, colframe=NCWUpurple!60!white,
  coltitle=white, fonttitle=\bfseries\sffamily\small,
  attach boxed title to top left={xshift=4mm, yshift=-2.5mm},
  boxed title style={colback=NCWUpurple, sharp corners,
    top=1.5pt, bottom=1.5pt, left=3pt, right=3pt}}{lem}

\newtcbtheorem[auto counter, number within=chapter]{proposition}{命题}{
  enhanced, breakable, arc=3pt, boxrule=0.8pt,
  top=10pt, bottom=6pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  colback=NCWUsky!8!white, colframe=NCWUsky!60!white,
  coltitle=white, fonttitle=\bfseries\sffamily\small,
  attach boxed title to top left={xshift=4mm, yshift=-2.5mm},
  boxed title style={colback=NCWUsky, sharp corners,
    top=1.5pt, bottom=1.5pt, left=3pt, right=3pt}}{prop}

\newtcbtheorem[auto counter, number within=chapter]{corollary}{推论}{
  enhanced, breakable, arc=3pt, boxrule=0.8pt,
  top=10pt, bottom=6pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  colback=NCWUcoral!8!white, colframe=NCWUcoral!60!white,
  coltitle=white, fonttitle=\bfseries\sffamily\small,
  attach boxed title to top left={xshift=4mm, yshift=-2.5mm},
  boxed title style={colback=NCWUcoral, sharp corners,
    top=1.5pt, bottom=1.5pt, left=3pt, right=3pt}}{cor}

\newtcbtheorem[auto counter, number within=chapter]{example}{例}{
  enhanced, breakable, arc=3pt, boxrule=0.8pt,
  top=10pt, bottom=6pt, left=8pt, right=8pt,
  before skip=10pt, after skip=10pt,
  colback=NCWUgreen!8!white, colframe=NCWUgreen!60!white,
  coltitle=white, fonttitle=\bfseries\sffamily\small,
  attach boxed title to top left={xshift=4mm, yshift=-2.5mm},
  boxed title style={colback=NCWUgreen, sharp corners,
    top=1.5pt, bottom=1.5pt, left=3pt, right=3pt}}{ex}

\newtcolorbox{remarkbox}[1][]{
  enhanced, breakable, before skip=8pt, after skip=8pt,
  colback=NCWUorange!8!white, colframe=NCWUorange!40!white,
  left=4mm, right=4mm, top=3pt, bottom=3pt, arc=3pt, boxrule=0.6pt,
  title={\sffamily\small\bfseries\color{NCWUorange}注记}, #1}

\newtcolorbox{proofbox}{
  enhanced, breakable, before skip=6pt, after skip=8pt,
  colback=NCWUgray!80!white, colframe=NCWUgray!60!white,
  left=4mm, right=4mm, top=3pt, bottom=3pt, arc=3pt, boxrule=0.4pt,
  title={\sffamily\small\bfseries\color{NCWUblue}证明},
  attach boxed title to top left={xshift=4mm, yshift=-2mm},
  boxed title style={colback=NCWUgray!80!white, boxrule=0pt},
  after upper={\hfill$\blacksquare$}}

\newtcolorbox{keyeq}[1][]{
  enhanced, before skip=10pt, after skip=10pt,
  colback=NCWUgold!10!white, colframe=NCWUgold!60!white,
  coltitle=NCWUdark, fonttitle=\sffamily\bfseries\small,
  attach boxed title to top right={xshift=-4mm, yshift=-2.5mm},
  boxed title style={colback=NCWUgold!30!white, sharp corners, boxrule=0.4pt},
  top=8pt, bottom=6pt, left=6pt, right=6pt, arc=3pt, boxrule=0.6pt,
  title={#1},}

\newtcolorbox{methodbox}[1][]{
  enhanced, before skip=10pt, after skip=10pt,
  colback=NCWUcream, colframe=NCWUgold!50!white,
  left=4mm, right=4mm, top=6pt, bottom=4pt, arc=3pt, boxrule=0.8pt,
  title={\sffamily\small\bfseries\color{NCWUgold}方法: #1}}

% ── Chapter/Section Formatting ──────────────────────────────
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\sffamily\color{NCWUblue}}
  {\filleft\fontsize{72}{72}\selectfont\color{NCWUblue!50!white}\thechapter}
  {0pt}
  {\filcenter\titlerule[2pt]\vskip 6pt}
  [\vskip 4pt{\color{NCWUblue!60}\titlerule[0.8pt]}\vskip -16pt]

\titleformat{\section}
  {\normalfont\Large\sffamily\bfseries\color{NCWUblue}}
  {\color{NCWUlight}\thesection\quad}{0pt}{}

\titleformat{\subsection}
  {\normalfont\large\sffamily\bfseries\color{NCWUlight}}
  {\thesubsection\quad}{0pt}{}

